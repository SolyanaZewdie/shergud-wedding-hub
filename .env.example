# Shergud — environment variables (copy to .env.local for local development,
# or paste into your host's environment settings on deploy).
#
# Both values come from your Supabase project: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: only needed if you add server-side admin work of your own.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
